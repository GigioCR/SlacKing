# Copy to .env.local for local development. On Vercel, set these in Project Settings →
# Environment Variables. `npm run secrets` prints fresh values for all the random ones.

# Supabase → Connect → Transaction pooler (port 6543). Without it, data is kept in memory.
DATABASE_URL=
# Optional: Supabase → Database → Settings → SSL Configuration → Download certificate (paste the
# PEM). With it, the database's certificate is checked; without it, the connection is still encrypted.
DATABASE_CA_CERT=

# The Claude Code hook sends this as a bearer token.
WEBHOOK_SECRET=
# Needed to link Microsoft Authenticator, and to link a new phone if you lose this one.
SETUP_CODE=
# Signs sign-in sessions. Changing it signs every browser out.
SESSION_SECRET=
# Encrypts the authenticator secret in the database. Changing it means linking the app again.
ENCRYPTION_KEY=

# Optional: the app's public address. Passkeys belong to it. Without it, each request's own
# address is used, which is right on Vercel.
APP_ORIGIN=

# Web push (npm run secrets, or npm run vapid).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
